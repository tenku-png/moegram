[Desktop Entry]
Name=moegram
Comment=Telegram Desktop client with a Python plugin engine, based on AyuGram
TryExec=moegram
Exec=env DESKTOPINTEGRATION=1 moegram -- %U
Icon=io.github.tenku_png.moegram
Terminal=false
StartupWMClass=moegram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=moegram;tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=moegram -quit
Name=Quit moegram
Icon=application-exit
